# "JS Demo" — the Zelto Script demo app. It has no executable: the .js entry is
# installed next to the other scripts and run by /usr/bin/zelto-script (see the
# manifest's exec=).
install_data(
  'jsdemo.js',
  install_dir : get_option('datadir') / 'zelto/scripts',
)

install_data(
  'zelto-jsdemo.app',
  install_dir : get_option('datadir') / 'zelto/apps',
)
