# Zelto app manifest (key=value). Scanned by the launcher from
# /usr/share/zelto/apps/*.app to build its install tiles, and by zsysd to learn
# which permissions an app may request (the `permissions=` line).
id=os.zelto.cards
name=Cards
subtitle=Tap to count · camera demo
exec=/usr/bin/zelto-cards
color=2e9bff
permissions=camera
