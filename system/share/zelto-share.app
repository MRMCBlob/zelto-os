# Zelto app manifest (key=value). Scanned by the launcher for its install tile.
# The Share app is purely an intent *source* (no handlers declared).
id=os.zelto.share
name=Share
subtitle=Share text + open a deep link
exec=/usr/bin/zelto-share
color=6a3db5
icon=/usr/share/zelto/apps/icons/os.zelto.share.png
