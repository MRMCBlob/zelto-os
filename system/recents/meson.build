# Recents (task overview): a libzelto OVERLAY layer-shell modal listing running
# app windows. fork/exec'd by the nav bar's Recents button. Installed as
# /usr/bin/zelto-recents.
executable(
  'zelto-recents',
  files('main.c'),
  include_directories : include_directories('..'),
  dependencies : zelto_dep,
  install : true,
)
