# The andemu demo — an emulated Android app. Like jsdemo it has no executable:
# the .js entry is installed next to the other scripts and run by
# /usr/bin/zelto-script --android (see the manifest's exec=).
install_data(
  'andemu-demo.js',
  install_dir : get_option('datadir') / 'zelto/scripts',
)

install_data(
  'zelto-andemu.app',
  install_dir : get_option('datadir') / 'zelto/apps',
)
