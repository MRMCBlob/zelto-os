# Zelto kernel config fragment for the QEMU 'virt' (aarch64) target.
#
# Merged on top of the mainline arm64 `defconfig` via scripts/kconfig/merge_config.sh
# (see build-kernel.sh). Keep this minimal and additive: it only forces on what
# Zelto needs that defconfig may leave as a module or off.
#
# Two groups:
#   1. Display + input for zcomp in QEMU (virtio-gpu DRM/KMS, virtio input).
#   2. Android-container prerequisites for Waydroid (binder + binderfs), per
#      docs/overview/how-it-runs-apks.md. (Waydroid itself is P-later; we enable
#      the kernel side now so the same kernel carries the OS forward.)

# --- Core virtio transports -------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y

# --- Display: virtio-gpu DRM/KMS (built-in, not module) ---------------------
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
# fbdev emulation + framebuffer console so we see kernel logs on the display.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Input: virtio-input (pointer / keyboard / touch) -----------------------
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# --- Boot path: initramfs + devtmpfs + tmpfs --------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Persistent storage (P11): virtio-blk disk + ext4 -----------------------
# A virtio-blk disk (QEMU -device virtio-blk-pci) backs /var/zelto, the writable
# data root for per-app prefs/files/SQLite. arm64 defconfig already enables both
# of these =y; listed here so a fresh kernel build is guaranteed to carry them.
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y

# --- Networking (P12): virtio-net + TCP/IP -----------------------------------
# QEMU user-mode networking (-netdev user + -device virtio-net-pci) presents a
# virtio-net NIC; apps with the `network` permission reach the host at 10.0.2.2.
# arm64 defconfig already enables these =y (and the inet stack); listed here so a
# fresh kernel build is guaranteed to carry them.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y

# --- Serial console on the virt PL011 UART ----------------------------------
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- Android container prerequisites (Waydroid) -----------------------------
# Binder IPC + binderfs (the on-demand binder device filesystem).
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Anonymous shared memory: mainline relies on memfd (CONFIG_MEMFD_CREATE is
# always-on / auto-selected since it has no prompt, so it is not listed here).
# Classic `ashmem` (CONFIG_ASHMEM) was removed from mainline in 5.18; modern
# Waydroid uses memfd, and older setups load the out-of-tree `ashmem_linux`
# module from anbox-modules. Nothing to enable in-tree for ashmem.

# Useful later for the Waydroid rootfs overlay (cheap to enable now).
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
